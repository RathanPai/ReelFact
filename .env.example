# LLM Configuration
# Options for LLM_PROVIDER: "ollama", "gemini", "openai", "lmstudio"
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Optional Cloud LLM Keys (fallback or alternate)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Search & Retrieval Configuration
# Options for SEARCH_PROVIDER: "duckduckgo", "tavily"
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=

# Processing & Hardware Settings
WHISPER_MODEL=base
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
OCR_USE_GPU=true
FRAME_SAMPLE_INTERVAL=1.5

# Paths
DATA_DIR=data
CACHE_DIR=data/cache
DATABASE_URL=sqlite+aiosqlite:///data/fact_checker.db
HOST=0.0.0.0
PORT=8000
