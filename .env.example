# Pipeline Mode: "native_multimodal" (Gemma 4 / LM Studio) or "legacy_cascaded" (Whisper + EasyOCR)
PIPELINE_MODE=native_multimodal

# LLM Configuration
# Options for LLM_PROVIDER: "lmstudio", "ollama", "gemini", "openai"
LLM_PROVIDER=lmstudio
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=gemma-4
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma-4:12b

# Multimodal Frame Processing (for Gemma 4 vision)
MULTIMODAL_MAX_FRAMES=8
MULTIMODAL_FRAME_MAX_DIM=0  # 0 = Full original native resolution (zero downscaling)

# Optional Cloud LLM Keys (fallback or alternate)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Search & Retrieval Configuration
# Options for SEARCH_PROVIDER: "duckduckgo", "tavily"
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=

# Processing & Hardware Settings
WHISPER_MODEL=base
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
OCR_USE_GPU=true
FRAME_SAMPLE_INTERVAL=1.5

# Paths
DATA_DIR=data
CACHE_DIR=data/cache
DATABASE_URL=sqlite+aiosqlite:///data/fact_checker.db
HOST=0.0.0.0
PORT=8000
